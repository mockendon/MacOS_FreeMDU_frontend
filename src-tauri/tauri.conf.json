{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeMDU",
  "version": "0.1.0",
  "identifier": "dev.freemdu.mac",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "FreeMDU", "width": 1000, "height": 700, "minWidth": 760, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
